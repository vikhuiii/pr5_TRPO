<Page x:Class="pr5_moskvina.AddCompPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pr5_moskvina"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddCompPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <Label Content="Id"/>
            <Label Content="Название"/>
            <Label Content="Назначение"/>
            <Label Content="Владелец"/>
            <Label Content="Общая цена"/>
            <Label Content="Компоненты"/>
        </StackPanel>
        <StackPanel Grid.Column="1">
            <TextBox Margin="5" Text="{Binding Id, Mode=OneWay}" IsReadOnly="True"/>
            <TextBox Margin="5" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Margin="5" Text="{Binding Purpose, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Margin="5" Text="{Binding Owner, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBox Margin="5" Text="{Binding BuildTotal, Mode=OneWay}" IsReadOnly="True"/>
            <ListBox x:Name="ComponentsList" Margin="5" ItemsSource="{Binding Components}" DisplayMemberPath="Name"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
            <Button Margin="5" Padding="5" Content="Добавить компонент" Click="addComponents_Click"/>
            <Button Margin="5" Padding="5" Content="Удалить компонент" Click="RemoveComponent_Click"/>
            <Button Margin="5" Padding="5" Content="Сохранить" Click="Button_Click_1"/>
            <Button Margin="5" Padding="5" Content="Назад" Click="Button_Click"/>
        </StackPanel>
    </Grid>
</Page>
