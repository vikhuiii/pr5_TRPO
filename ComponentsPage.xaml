<Page x:Class="pr5_moskvina.ComponentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pr5_moskvina"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ComponentsPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Label Content="Компоненты компьютера №"/>
            <Label Content="{Binding Id}"/>
        </StackPanel>
        <ListView x:Name="ComponentsList"
                  Grid.Row="1"
                  ItemsSource="{Binding Components}"
                  MouseDoubleClick="EditComponent_Click">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Название: "/>
                            <TextBlock Text="{Binding Name}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Тип: "/>
                            <TextBlock Text="{Binding Type}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Цена: "/>
                            <TextBlock Text="{Binding Price}"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Background="AntiqueWhite">
            <Button Margin="5" Padding="5" Content="Добавить компонент" Click="AddComponent_Click"/>
            <Button Margin="5" Padding="5" Content="Удалить компонент" Click="RemoveComponent_Click"/>
            <Button Margin="5" Padding="5" Content="Назад" Click="Back_Click"/>
            <Label>Всего в списке:</Label>
            <Label Content="{Binding Components.Count}"/>
        </StackPanel>
    </Grid>
</Page>
