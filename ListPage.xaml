<Page x:Class="pr5_moskvina.ListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pr5_moskvina"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ListPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
            <Button x:Name="AddBtn" Margin="5" Padding="5" Click="AddBtn_Click">Добавить</Button>
            <Button x:Name="ViewBtn" Margin="5" Padding="5" Click="ViewBtn_Click">Посмотреть компоненты</Button>
            <Button x:Name="DeleteBtn" Margin="5" Padding="5" Click="DeleteBtn_Click">Удалить</Button>
            <Button x:Name="SaveBtn" Margin="5" Padding="5" Click="SaveBtn_Click">Сохранить в JSON</Button>
        </StackPanel>

        <ListView Grid.Row="1" Grid.ColumnSpan="2"
                  ItemsSource="{Binding Comps}"
                  SelectedItem="{Binding SelectedComp}"
                  MouseDoubleClick="EditItem_Click">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Идентификатор: "/>
                            <TextBlock Text="{Binding Id}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Название: "/>
                            <TextBlock Text="{Binding Name}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Назначение: "/>
                            <TextBlock Text="{Binding Purpose}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Владелец: "/>
                            <TextBlock Text="{Binding Owner}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Общая стоимость сборки: "/>
                            <TextBlock Text="{Binding BuildTotal}"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.ColumnSpan="2" Background="AntiqueWhite">
            <Label>Всего в списке:</Label>
            <Label Content="{Binding Comps.Count}"/>
        </StackPanel>
    </Grid>
</Page>